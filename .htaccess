# Security settings for Apache web hosting.
# Every block is wrapped in <IfModule>, so a missing module never breaks the site.

Options -Indexes
DirectoryIndex index.html
ServerSignature Off
AddDefaultCharset UTF-8
AddType font/woff2 .woff2
AddType image/svg+xml .svg

# Never serve hidden files/folders (.git, .htaccess, ...) or project notes (*.md).
<IfModule mod_alias.c>
  RedirectMatch 404 "(^|/)\."
  RedirectMatch 404 "\.md$"
</IfModule>

# Redirect http:// to https://. If your host has no SSL certificate yet, enable
# one first (most hosts offer a free Let's Encrypt certificate) – or comment
# these lines out.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  # Only files from this site may load; no inline scripts, no framing by other sites.
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  # Browsers ignore HSTS on plain http, so it is only sent over https.
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header unset X-Powered-By
</IfModule>
